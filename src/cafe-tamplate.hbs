{{#each cafe}}
    <li class="item">
        <h2>Назва: {{name}}</h2>
        <p>Тип зерна: {{type}}</p>
        <p>Походження: {{origin_country}}</p>
        <ul>
        {{#each flavor_notes}}
            <li>Інгредієнти: {{this}}</li>
        {{/each}}
        </ul>
        <p>Ціна за 100 грам: {{price_per_100g}}</p>
    </li>
{{/each}}